{
  "name": "email-writer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @email-writer/browser-extension dev",
    "dev:firefox": "pnpm --filter @email-writer/browser-extension dev:firefox",
    "build": "pnpm --filter @email-writer/ai-companion build && pnpm --filter @email-writer/browser-extension build:all",
    "ai:build": "pnpm --filter @email-writer/ai-companion build",
    "ai:install": "pnpm --filter @email-writer/ai-companion install-host",
    "build:test": "pnpm --filter @email-writer/browser-extension build:test",
    "typecheck": "pnpm -r --parallel typecheck && vue-tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:test && playwright test",
    "test:firefox": "pnpm build:test && node tests/e2e/extension-firefox/run-smoke.mjs",
    "lint:firefox": "pnpm build && web-ext lint --source-dir apps/browser-extension/.output/firefox-mv3",
    "outlook:firefox": "node tests/manual/outlook-live/launch-firefox.mjs",
    "outlook:dev": "node tests/manual/outlook-live/dev-extension.mjs",
    "outlook:inspect": "node tests/manual/outlook-live/inspect.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "release:version": "node scripts/release-version.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm verify:packages"
  },
  "devDependencies": {
    "@email-writer/ai-claude-code": "workspace:*",
    "@email-writer/ai-openai": "workspace:*",
    "@email-writer/email-format": "workspace:*",
    "jose": "^6.1.0",
    "@email-writer/contracts": "workspace:*",
    "@email-writer/core": "workspace:*",
    "@email-writer/outlook-web": "workspace:*",
    "@email-writer/ui": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
